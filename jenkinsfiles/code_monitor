pipeline {
    agent any

    environment {
        PATH = "/home/ubuntu/miniconda3/bin:$PATH"
    }

    stages {

        stage('Init Vars') {
            steps {
                script {
                    sourceBranch = env.CHANGE_BRANCH ?: env.BRANCH_NAME
                    targetBranch = env.CHANGE_TARGET ?: 'stage'

                    echo "[info] Source Branch: ${sourceBranch}"
                    echo "[info] Target Branch: ${targetBranch}"
                    echo "[info] Current Branch: ${env.BRANCH_NAME}"
                }
            }
        }

        stage('Repos') {
            steps {

                cleanWs(
                    deleteDirs: true,
                    notFailBuild: true,
                    patterns: [[pattern: '*', type: 'INCLUDE']]
                )

                script {

                    echo "[info] BACKUP PROD FILES"
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/prod"]],
                        userRemoteConfigs: [[
                            credentialsId: "github-credentials",
                            url: "https://github.com/Projectproakash26/sbert-search-bar.git"
                        ]]
                    ])

                    sh '''
                    mkdir -p temp_ml
                    [ -f data/project_mappings.csv ] && cp data/project_mappings.csv temp_ml/project_mappings.csv
                    [ -f output/search.index ] && cp output/search.index temp_ml/search.index
                    '''

                    echo "[info] CHECKOUT SOURCE BRANCH"
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/${sourceBranch}"]],
                        userRemoteConfigs: [[
                            credentialsId: "github-credentials",
                            url: "https://github.com/Projectproakash26/sbert-search-bar.git"
                        ]]
                    ])

                    sh """
                    git pull origin ${sourceBranch} --rebase
                    """

                    echo "[info] MERGE SOURCE → STAGE"
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/stage"]],
                        userRemoteConfigs: [[
                            credentialsId: "github-credentials",
                            url: "https://github.com/Projectproakash26/sbert-search-bar.git"
                        ]]
                    ])

                    sh """
                        git checkout stage
                        git pull origin stage --rebase
                        git merge origin/${sourceBranch} --no-edit
                    """
                }
            }
        }

        stage("Setup ML Environment") {
            steps {
                sh '''
                . /home/ubuntu/miniconda3/etc/profile.d/conda.sh

                if conda env list | grep -q sbar-code; then
                    echo "[info] Environment exists"
                else
                    conda create -y -n sbar-code python=3.10
                fi

                conda activate sbar-code
                pip install -r requirements.txt
                '''
            }
        }

        stage("Functional Tests") {
            steps {
                sh '''
                . /home/ubuntu/miniconda3/etc/profile.d/conda.sh
                conda activate sbar-code
                python -m unittest discover -s test -p "test*.py"
                '''
            }
        }

        stage("Build Search Index") {
            steps {
                sh '''
                . /home/ubuntu/miniconda3/etc/profile.d/conda.sh
                conda activate sbar-code

                echo "[info] Before running engine.py" > log.txt
                python engine.py >> log.txt
                '''
            }
        }

        stage("Push Changes to Stage") {
            steps {
                script {

                    sh '''
                    . /home/ubuntu/miniconda3/etc/profile.d/conda.sh
                    conda activate sbar-code
                    python validate_changes.py >> log.txt
                    '''

                    def lastLine = sh(returnStdout: true, script: "tail -n 1 log.txt").trim()

                    if (!lastLine.contains("CHANGE VALIDATION: SUCCESS")) {
                        error("[info] Validation failed")
                    }

                    echo "[info] Validation SUCCESS → pushing to stage"

                    def commitMsg = env.CHANGE_ID ?
                        "[jenkins-server autocommit] ${env.CHANGE_TITLE} #${env.CHANGE_ID}" :
                        "[jenkins-server autocommit] ${env.BRANCH_NAME}"

                    sh "git add ."
                    sh "git commit -m \"${commitMsg}\""

                    withCredentials([usernamePassword(credentialsId: 'github-credentials',
                        usernameVariable: 'USER',
                        passwordVariable: 'TOKEN')]) {

                        sh """
                        git push https://${USER}:${TOKEN}@github.com/Projectproakash26/sbert-search-bar.git stage
                        """
                    }
                }
            }
        }

        stage("Deploy Changes to Production") {
            steps {
                sh '''
                git checkout prod
                git pull origin prod --rebase
                git merge stage --no-edit
                git push origin prod
                '''

                build job: 'job-update-search-bar', parameters: []
            }
        }
    }
}
